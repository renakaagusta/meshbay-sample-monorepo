{
  "name": "meshbay-sample-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @meshbay/web build",
    "start": "pnpm --parallel --filter \"./apps/*\" start",
    "check": "pnpm --filter @meshbay/api check && pnpm --filter @meshbay/web typecheck"
  }
}
